# ============================================
# LARGE DATA FILES
# ============================================

# Raw data files
data/raw/*.json
data/raw/*.json.gz
data/processed/*.parquet

# IMDb dataset (50K+ text files)
data/imdb_raw/
data/imdb_raw/**/*

# Allow the 200K dataset (62MB - under GitHub limit)
!data/deep_learning_data/movies_reviews_200k.parquet
!data/deep_learning_data/movies_reviews_200k.csv

# ============================================
# MODEL FILES & TRAINING ARTIFACTS
# ============================================

# Large model binary files
*.keras
*.h5
*.model
*.npy
*.npz
*.pkl
*.pickle

# Model checkpoints and weights
results/**/*.keras
results/**/*.h5
results/**/*.model
results/**/*.npy
results/**/*.pkl
checkpoints/
*.ckpt

# Word2Vec models
*.bin
*.vec
*.txt.model
fasttext_models/
word2vec_models/

# ============================================
# KEEP IMPORTANT FILES
# ============================================

# Keep visualizations and reports
!results/**/*.png
!results/**/*.jpg
!results/**/*.svg
!results/**/*.pdf

# Keep CSV summaries and metrics
!results/**/*.csv
!results/**/model_metrics_summary.csv

# Keep analysis notebooks
!*.ipynb
!analyze_results.ipynb

# Keep JSON config files
!results/**/*.json

